OPENAI_API_KEY=<OpenAI_API_Key> 
SQLALCHEMY_DATABASE_URL=<Connection_string>

# Prometheus Metrics Configuration
METRICS_ENABLED=<true/false>
METRICS_ENDPOINT=<endpoint> # /metrics
 
# Enable/disable specific metric categories
ENABLE_HTTP_METRICS=<true/false>
ENABLE_BUSINESS_METRICS=<true/false>
ENABLE_DATABASE_METRICS=<true/false>
 
# Metric collection intervals (seconds)
METRICS_COLLECTION_INTERVAL=<int>
